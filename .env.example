# =============================================================================
# AcervoProfissional — Variáveis de ambiente locais
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NÃO deve ser versionado no Git.
# Este arquivo é apenas referência; as variáveis não são carregadas
# automaticamente pelos hosts — devem ser exportadas no shell ou configuradas
# via launchSettings.json.
# =============================================================================

# --- API (AcervoProfissional.Api) ---
# Ambiente do ASP.NET Core (usado pelo host com UseWebApplication)
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000

# --- Worker (AcervoProfissional.Worker) ---
# Ambiente do Generic Host (usado por Worker e MCP — NÃO usar ASPNETCORE_ENVIRONMENT aqui)
DOTNET_ENVIRONMENT=Development
WORKER_INTERVAL_SECONDS=60

# --- MCP (AcervoProfissional.Mcp) ---
# Ambiente do Generic Host (compartilha DOTNET_ENVIRONMENT com o Worker)
MCP_INTERVAL_SECONDS=60
MCP_PORT=5100

# --- Banco de dados (a definir) ---
# CONNECTION_STRING=Server=localhost;Database=acervo;User Id=sa;Password=sua_senha;

# --- OpenRouter / IA (a definir) ---
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Outros secrets ---
# JWT_SECRET=seu_jwt_secret_aqui
