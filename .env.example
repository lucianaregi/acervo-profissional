# =============================================================================
# AcervoProfissional — Variáveis de ambiente locais
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# O arquivo .env NÃO deve ser versionado no Git.
# =============================================================================

# --- Ambiente ---
ASPNETCORE_ENVIRONMENT=Development

# --- API (AcervoProfissional.Api) ---
API_PORT=5000

# --- Worker (AcervoProfissional.Worker) ---
WORKER_INTERVAL_SECONDS=60

# --- MCP (AcervoProfissional.Mcp) ---
MCP_PORT=5100

# --- Banco de dados (a definir) ---
# CONNECTION_STRING=Server=localhost;Database=acervo;User Id=sa;Password=sua_senha;

# --- OpenRouter / IA (a definir) ---
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Outros secrets ---
# JWT_SECRET=seu_jwt_secret_aqui
